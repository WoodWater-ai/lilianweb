# Production template only. Never enter real credentials in this tracked file.
# Copy to a protected file OUTSIDE admin/deploy, or configure the hosting secret store.
# Node does not load this template automatically.
NODE_ENV=production
WEBSITE_HOST=127.0.0.1
WEBSITE_PORT=4317

# Feishu enterprise self-built application credentials, supplied by the owner.
# This app needs read/write access to the existing Base and both tables.
FEISHU_APP_ID=
FEISHU_APP_SECRET=

# Optional: exact IPs of trusted reverse proxies, comma separated.
# Configure only after verifying the proxy overwrites X-Real-IP.
WEBSITE_TRUSTED_PROXY_IPS=
